# ============================================================================
# LinkedIn CRM — env vars
# Copy to .env.local for local dev, or set them in Vercel project settings.
# Never commit the filled file.
# ============================================================================

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...
SUPABASE_SERVICE_ROLE_KEY=eyJh...

# --- Unipile (required for any LinkedIn action) ---
# Your Unipile DSN, e.g. api1.unipile.com:443
UNIPILE_DSN=
UNIPILE_API_KEY=

# Legacy single-account fallback. The app prefers the multi-account table
# linkedin_accounts; this var is only used if that table is empty.
LINKEDIN_ACCOUNT_ID=

# --- Google Gemini (required for scoring + message generation) ---
GEMINI_API_KEY=

# --- Business context (optional, defaults to a SEO/B2B example) ---
# One sentence describing your ICP — used by the AI when scoring signals + leads.
SIGNAL_BUSINESS_CONTEXT="Agence/freelance SEO et acquisition B2B."

# --- Cron protection (recommended for prod) ---
# Random string. Cron endpoints reject requests without "Authorization: Bearer ${CRON_SECRET}".
CRON_SECRET=
